[0m14:43:33.261396 [debug] [Thread-7 (]: On model.dbtlearn.silver_salesinfo: /* {"app": "dbt", "dbt_version": "1.11.11", "dbt_databricks_version": "1.10.9", "databricks_sql_connector_version": "4.2.6", "profile_name": "dbtlearn", "target_name": "dev", "node_id": "model.dbtlearn.silver_salesinfo"} */

  
    
        create or replace table `dbt_learn_dev`.`silver`.`silver_salesinfo`
      
      
  using delta
      
      
      
      
      
      
      
      as
      WITH sales AS
(
    SELECT 
        sales_id,
        product_sk,
        customer_sk,
        

    unit_price*quantity

 as calculated_gross_amt,
        gross_amount,
        payment_method
    FROM 
        `dbt_learn_dev`.`bronze`.`bronze_sales`
),

products AS 
(
    SELECT 
        product_sk,
        category
    FROM 
        `dbt_learn_dev`.`bronze`.`bronze_product`

),

customer AS
(
    SELECT
        customer_sk,
        gender
    FROM 
        `dbt_learn_dev`.`bronze`.`bronze_customer`
),

joined_query AS(
SELECT
    sales.sales_id,
    sales.gross_amount,
    sales.payment_method,
    products.category,
    customer.gender
FROM
    sales
JOIN
    products ON sales.product_sk = products.product_sk
JOIN
    customer ON sales.customer_sk = customer.customer_sk
)

SELECT
    category,
    gender,
    sum(gross_amount) as total_sales
FROM joined_query
GROUP BY
    category,
    gender
ORDER BY
    total_sales
  
