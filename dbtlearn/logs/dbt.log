        create or replace table `dbt_learn_dev`.`silver`.`silver_salesinfo`
      
      
  using delta
      
      
      
      
      
      
      
      as
      WITH sales AS
(
    SELECT 
        sales_id,
        product_sk,
        customer_sk,
        

    unit_price*quantity

 as calculated_gross_amt,
        gross_amount,
        payment_method
    FROM 
        `dbt_learn_dev`.`bronze`.`bronze_sales`
),

products AS 
(
    SELECT 
        product_sk,
        category
    FROM 
        `dbt_learn_dev`.`bronze`.`bronze_product`

),

customer AS
(
    SELECT
        customer_sk,
        gender
    FROM 
        `dbt_learn_dev`.`bronze`.`bronze_customer`
),

joined_query AS(
SELECT
    sales.sales_id,
    sales.gross_amount,
    sales.payment_method,
    products.category,
    customer.gender
FROM
    sales
JOIN
    products ON sales.product_sk = products.product_sk
JOIN
    customer ON sales.customer_sk = customer.customer_sk
)

SELECT
    category,
    gender,
    sum(gross_amount) as total_sales
FROM joined_query
GROUP BY
    category,
    gender
ORDER BY
    total_sales
  
